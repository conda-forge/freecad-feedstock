diff --git a/cMake/FindPySide6.cmake b/cMake/FindPySide6.cmake
index ac5e837..326216c 100644
--- a/cMake/FindPySide6.cmake
+++ b/cMake/FindPySide6.cmake
@@ -45,7 +45,9 @@ if(PySide6_FOUND)
         list(APPEND _pyside6_qtsvgwidgets_consumers BUILD_MATERIAL)
     endif()
 
-    if(BUILD_GUI AND _pyside6_qtsvgwidgets_consumers)
+    # the check imports PySide6 with the build-time python, which cannot
+    # load target-architecture extension modules when cross compiling
+    if(BUILD_GUI AND _pyside6_qtsvgwidgets_consumers AND FREECAD_CHECK_PYSIDE)
         execute_process(
             COMMAND ${Python3_EXECUTABLE} -c "import PySide6.QtSvgWidgets"
             RESULT_VARIABLE PYSIDE6_QTSVGWIDGETS_IMPORT_FAILED
diff --git a/cMake/FreeCAD_Helpers/InitializeFreeCADBuildOptions.cmake b/cMake/FreeCAD_Helpers/InitializeFreeCADBuildOptions.cmake
